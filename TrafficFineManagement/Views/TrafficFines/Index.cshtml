@model IEnumerable<TrafficFineManagement.Models.TrafficFine>
@using TrafficFineManagement.Enums

@{
    ViewData["Title"] = "Trafik Cezaları";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Trafik Cezaları</h2>
            <p class="text-muted mb-0">
                Sistemde kayıtlı trafik cezalarını görüntüleyin.
            </p>
        </div>

        <a asp-controller="TrafficFines"
           asp-action="Create"
           class="btn btn-primary">
            + Yeni Ceza Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tutanak No</th>
                            <th>Plaka</th>
                            <th>Ceza Tutarı</th>
                            <th>Ceza Tarihi</th>
                            <th>Durum</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5 text-muted">
                                    Henüz kayıtlı trafik cezası bulunmuyor.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var fine in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @fine.FineNumber
                                    </td>

                                    <td>@fine.Vehicle.PlateNumber</td>

                                    <td>
                                        @fine.Amount.ToString("N2") TL
                                    </td>

                                    <td>
                                        @fine.FineDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        @switch (fine.Status)
                                        {
                                            case FineStatus.New:
                                                <span class="badge bg-secondary">
                                                    Yeni
                                                </span>
                                                break;

                                            case FineStatus.PendingManagerApproval:
                                                <span class="badge bg-warning text-dark">
                                                    Yönetici Onayı Bekliyor
                                                </span>
                                                break;

                                            case FineStatus.PendingFinanceApproval:
                                                <span class="badge bg-info text-dark">
                                                    Finans Onayı Bekliyor
                                                </span>
                                                break;

                                            case FineStatus.Completed:
                                                <span class="badge bg-success">
                                                    Tamamlandı
                                                </span>
                                                break;

                                            case FineStatus.Rejected:
                                                <span class="badge bg-danger">
                                                    Reddedildi
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td>
                                        <a asp-controller="TrafficFines"
                                           asp-action="Details"
                                           asp-route-id="@fine.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Detay
                                        </a>
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
