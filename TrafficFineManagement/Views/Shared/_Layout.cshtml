@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    bool isApprover = User.IsInRole("Manager") || User.IsInRole("Finance");
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FineFlow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TrafficFineManagement.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
</head>

<body class="app-body">

    <!-- Sayfa genelinde kullanılan SVG ikonlar -->
    <svg xmlns="http://www.w3.org/2000/svg"
         class="svg-icon-library"
         aria-hidden="true">

        <symbol id="icon-dashboard" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="9" rx="1" />
            <rect x="14" y="3" width="7" height="5" rx="1" />
            <rect x="14" y="12" width="7" height="9" rx="1" />
            <rect x="3" y="16" width="7" height="5" rx="1" />
        </symbol>

        <symbol id="icon-car" viewBox="0 0 24 24">
            <path d="M5 17H3v-5l2-6a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 6v5h-2" />
            <path d="M5 17h14M5 12h14M7 12l1-7M17 12l-1-7" />
            <path d="M5 17v2h3v-2M16 17v2h3v-2" />
            <path d="M7 14h2M15 14h2" />
        </symbol>

        <symbol id="icon-file" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6M8 13h8M8 17h8" />
        </symbol>

        <symbol id="icon-approval" viewBox="0 0 24 24">
            <rect x="5" y="4" width="14" height="18" rx="2" />
            <path d="M9 4.5V3h6v1.5M9 13l2 2 4-4" />
        </symbol>

        <symbol id="icon-clock" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </symbol>

        <symbol id="icon-check" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12l3 3 5-6" />
        </symbol>

        <symbol id="icon-rejected" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M9 9l6 6M15 9l-6 6" />
        </symbol>

        <symbol id="icon-chart" viewBox="0 0 24 24">
            <path d="M4 20V4M4 20h16M8 16v-5M13 16V7M18 16V4" />
        </symbol>

        <symbol id="icon-plus" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14" />
        </symbol>

        <symbol id="icon-arrow" viewBox="0 0 24 24">
            <path d="M5 12h14M13 6l6 6-6 6" />
        </symbol>

        <symbol id="icon-search" viewBox="0 0 24 24">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M16 16l5 5" />
        </symbol>

        <symbol id="icon-wallet" viewBox="0 0 24 24">
            <rect x="3" y="6" width="18" height="15" rx="2" />
            <path d="M3 10h18M16 15h2" />
        </symbol>

        <symbol id="icon-sparkles" viewBox="0 0 24 24">
            <path d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8z" />
            <path d="M19 17v5M16.5 19.5h5" />
        </symbol>

        <symbol id="icon-menu" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </symbol>

        <symbol id="icon-user" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
        </symbol>

    </svg>

    <div class="app-shell">

        <aside class="app-sidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-brand text-decoration-none">

                <div class="brand-icon">
                    <svg class="ui-icon">
                        <use href="#icon-approval"></use>
                    </svg>
                </div>

                <div>
                    <div class="brand-name">FineFlow</div>
                    <div class="brand-subtitle">
                        TRAFİK CEZASI YÖNETİMİ
                    </div>
                </div>
            </a>

            <div class="collapse d-lg-flex flex-column flex-grow-1"
                 id="appSidebarNav">

                <nav class="sidebar-navigation">

                    <div class="sidebar-label">ANA MENÜ</div>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link @(controller == "Home" && action == "Index" ? "active" : "")">

                        <svg class="ui-icon">
                            <use href="#icon-dashboard"></use>
                        </svg>

                        <span>Genel Bakış</span>
                    </a>

                    @if (isLoggedIn)
                    {
                        <a asp-controller="Vehicles"
                           asp-action="Index"
                           class="sidebar-link @(controller == "Vehicles" ? "active" : "")">

                            <svg class="ui-icon">
                                <use href="#icon-car"></use>
                            </svg>

                            <span>Araç Yönetimi</span>
                        </a>

                        <a asp-controller="TrafficFines"
                           asp-action="Index"
                           class="sidebar-link @(controller == "TrafficFines" ? "active" : "")">

                            <svg class="ui-icon">
                                <use href="#icon-file"></use>
                            </svg>

                            <span>Trafik Cezaları</span>
                        </a>

                        @if (isApprover)
                        {
                            <div class="sidebar-label mt-4">
                                ONAY YÖNETİMİ
                            </div>

                            <a asp-controller="TrafficFines"
                               asp-action="Index"
                               class="sidebar-link">

                                <svg class="ui-icon">
                                    <use href="#icon-approval"></use>
                                </svg>

                                <span>Onay Süreçleri</span>
                            </a>
                        }
                    }

                </nav>

                <div class="sidebar-bottom">
                    <div class="sidebar-info">
                        <span class="sidebar-info-dot"></span>
                        Sistem Yönetim Paneli
                    </div>
                    <div class="sidebar-version">
                        FineFlow · .NET 8 MVC
                    </div>
                </div>

            </div>
        </aside>

        <div class="app-main">

            <header class="app-topbar">

                <div class="topbar-left">

                    <button class="btn sidebar-toggle d-lg-none"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#appSidebarNav"
                            aria-label="Menüyü aç veya kapat"
                            aria-expanded="false"
                            aria-controls="appSidebarNav">

                        <svg class="ui-icon">
                            <use href="#icon-menu"></use>
                        </svg>
                    </button>

                    <div>
                        <div class="topbar-title">
                            Trafik Cezası Yönetim Sistemi
                        </div>
                        <div class="topbar-subtitle">
                            Yönetim ve onay platformu
                        </div>
                    </div>
                </div>

                <div class="topbar-user">
                    <partial name="_LoginPartial" />
                </div>

            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                © 2026 FineFlow · Trafik Cezası Yönetim Sistemi
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
